{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://drone-show-studio/schemas/project_intermediate.schema.json",
  "title": "Drone Show Studio - Phase 1 Intermediate Export",
  "description": "Source-of-truth interchange format produced by the Blender add-on (stage1_designer) and consumed by the Core Engine (stage2_core_engine).",
  "type": "object",
  "required": ["project_metadata", "keyframes"],
  "additionalProperties": false,
  "definitions": {
    "leg": {
      "type": "object",
      "required": ["duration_sec"],
      "additionalProperties": false,
      "properties": {
        "duration_sec": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "exclusiveMinimum": 0 }
          ]
        }
      }
    }
  },
  "properties": {
    "project_metadata": {
      "type": "object",
      "required": [
        "version",
        "fleet_size",
        "sampling_mode",
        "fps",
        "total_duration_sec",
        "safety_radius_m",
        "min_distance_m",
        "coordinate_system",
        "heading_offset_deg",
        "origin_gps"
      ],
      "anyOf": [
        { "required": ["holding_areas"] },
        { "required": ["holding_area"] }
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "fleet_size": { "type": "integer", "minimum": 1 },
        "sampling_mode": { "type": "string", "enum": ["KEYFRAME_ONLY", "DENSE_SAMPLED"] },
        "fps": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "total_duration_sec": { "type": "number", "minimum": 0 },
        "safety_radius_m": { "type": "number", "exclusiveMinimum": 0 },
        "min_distance_m": { "type": "number", "exclusiveMinimum": 0 },
        "coordinate_system": { "type": "string", "const": "ENU" },
        "heading_offset_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "ground_z_m": {
          "description": "ENU height of the ground (added in 1.6.0, optional; absent = 0.0, the ENU origin plane).",
          "type": "number"
        },
        "origin_gps": {
          "type": "object",
          "required": ["latitude", "longitude", "altitude_amsl"],
          "additionalProperties": false,
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "altitude_amsl": { "type": "number" }
          }
        },
        "holding_area": {
          "description": "Up to 1.7.0: the one holding area, home of the whole fleet. 1.8.0 files carry holding_areas instead; readers accept both, holding_area meaning a one-item list.",
          "type": "object",
          "required": ["center", "size", "max_height", "grid_spacing_m", "layer_spacing_m"],
          "additionalProperties": false,
          "properties": {
            "center": {
              "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
            },
            "size": {
              "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
            },
            "max_height": { "type": "number", "exclusiveMinimum": 0 },
            "grid_spacing_m": { "type": "number", "minimum": 1.8 },
            "layer_spacing_m": {
              "description": "Vertical gap between stacked layers. Honoured since 1.7.0 (default 4.0); older files carry grid_spacing_m here, the straight stacking they were laid out with.",
              "type": "number", "exclusiveMinimum": 0
            },
            "staggered_layers": {
              "description": "Added in 1.7.0, optional (absent = false). Odd layers are shifted half a slot in x and y and have one column and one row fewer, so no slot sits straight above another.",
              "type": "boolean"
            },
            "show_clearance_m": {
              "description": "The designer's Safe Distance to Show (added in 1.6.0, optional). When present, Stage 2 keeps show drones at least this far from the holding region.",
              "type": "number", "minimum": 0
            }
          }
        },
        "holding_areas": {
          "description": "Added in 1.8.0, replaces holding_area. Each area is laid out like holding_area for its own slot_count drones; only the last one widens when the fleet is too big for them.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["center", "size", "max_height", "grid_spacing_m", "layer_spacing_m", "slot_count"],
            "additionalProperties": false,
            "properties": {
              "center": {
                "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
              },
              "size": {
                "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
              },
              "max_height": { "type": "number", "exclusiveMinimum": 0 },
              "grid_spacing_m": { "type": "number", "minimum": 1.8 },
              "layer_spacing_m": { "type": "number", "exclusiveMinimum": 0 },
              "staggered_layers": { "type": "boolean" },
              "show_clearance_m": { "type": "number", "minimum": 0 },
              "slot_count": {
                "description": "The drones that take off from this area, and the slots laid out in it. The fleet fills the areas in list order, the counts add up to fleet_size, and drone i takes off from slot i of every area's slots concatenated in list order. Drones land, park and return on any free slot of any area.",
                "type": "integer", "minimum": 0
              }
            }
          }
        },
        "kinematic_constraints": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["v_max_mps", "a_max_mps2", "j_max_mps3"],
              "additionalProperties": false,
              "properties": {
                "v_max_mps": { "type": "number", "exclusiveMinimum": 0 },
                "a_max_mps2": { "type": "number", "exclusiveMinimum": 0 },
                "j_max_mps3": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          ]
        },
        "legs": {
          "description": "Takeoff (holding area -> first keyframe) and return (last keyframe -> holding area) legs. Added in 1.6.0 and optional, so older files stay valid. duration_sec: target in seconds, or null for Auto (Stage 2's minimum); Stage 2 flies max(target, minimum).",
          "type": "object",
          "required": ["takeoff", "return"],
          "additionalProperties": false,
          "properties": {
            "takeoff": { "$ref": "#/definitions/leg" },
            "return": { "$ref": "#/definitions/leg" }
          }
        },
        "waiting_areas": {
          "description": "Added in 1.7.0, optional (absent or empty = none). Places in the air where spare drones wait (LEDs off) instead of flying home mid-show. Each is one flat layer of slots at center z; slot_count slots are laid out (the declared grid; when the declared slots are too few, every area grows by the same number of slots).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["center", "size", "grid_spacing_m", "show_clearance_m", "slot_count"],
            "additionalProperties": false,
            "properties": {
              "center": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "size": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
              "grid_spacing_m": { "type": "number", "minimum": 1.8 },
              "show_clearance_m": { "type": "number", "minimum": 0 },
              "slot_count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["time_sec", "shape_name", "points"],
        "additionalProperties": false,
        "properties": {
          "time_sec": { "type": "number", "minimum": 0 },
          "shape_name": { "type": "string" },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "pos", "color"],
              "additionalProperties": false,
              "properties": {
                "index": { "type": "integer", "minimum": 0 },
                "pos": {
                  "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
                },
                "color": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 0, "maximum": 255 },
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        }
      }
    }
  }
}
