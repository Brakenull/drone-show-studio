{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://drone-show-studio/schemas/project_intermediate.schema.json",
  "title": "Drone Show Studio - Phase 1 Intermediate Export",
  "description": "Source-of-truth interchange format produced by the Blender add-on (stage1_designer) and consumed by the Core Engine (stage2_core_engine).",
  "type": "object",
  "required": ["project_metadata", "keyframes"],
  "additionalProperties": false,
  "properties": {
    "project_metadata": {
      "type": "object",
      "required": [
        "version",
        "fleet_size",
        "sampling_mode",
        "fps",
        "total_duration_sec",
        "safety_radius_m",
        "min_distance_m",
        "coordinate_system",
        "heading_offset_deg",
        "origin_gps",
        "holding_area"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "fleet_size": { "type": "integer", "minimum": 1 },
        "sampling_mode": { "type": "string", "enum": ["KEYFRAME_ONLY", "DENSE_SAMPLED"] },
        "fps": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "total_duration_sec": { "type": "number", "minimum": 0 },
        "safety_radius_m": { "type": "number", "exclusiveMinimum": 0 },
        "min_distance_m": { "type": "number", "exclusiveMinimum": 0 },
        "coordinate_system": { "type": "string", "const": "ENU" },
        "heading_offset_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "origin_gps": {
          "type": "object",
          "required": ["latitude", "longitude", "altitude_amsl"],
          "additionalProperties": false,
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "altitude_amsl": { "type": "number" }
          }
        },
        "holding_area": {
          "type": "object",
          "required": ["center", "size", "max_height", "layer_spacing_m"],
          "additionalProperties": false,
          "properties": {
            "center": {
              "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
            },
            "size": {
              "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
            },
            "max_height": { "type": "number", "exclusiveMinimum": 0 },
            "layer_spacing_m": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "kinematic_constraints": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["v_max_mps", "a_max_mps2", "j_max_mps3"],
              "additionalProperties": false,
              "properties": {
                "v_max_mps": { "type": "number", "exclusiveMinimum": 0 },
                "a_max_mps2": { "type": "number", "exclusiveMinimum": 0 },
                "j_max_mps3": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          ]
        }
      }
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["time_sec", "shape_name", "points"],
        "additionalProperties": false,
        "properties": {
          "time_sec": { "type": "number", "minimum": 0 },
          "shape_name": { "type": "string" },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "pos", "color"],
              "additionalProperties": false,
              "properties": {
                "index": { "type": "integer", "minimum": 0 },
                "pos": {
                  "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
                },
                "color": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 0, "maximum": 255 },
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        }
      }
    }
  }
}
