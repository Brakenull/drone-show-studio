{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Ninja, vcpkg manifest)",
      "description": "Run from a Visual Studio developer shell (setup.ps1 opens one). vcpkg installs the libraries listed in the repo's vcpkg.json into <repo>/vcpkg_installed.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_DIR": "${sourceParentDir}",
        "VCPKG_INSTALLED_DIR": "${sourceParentDir}/vcpkg_installed"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
