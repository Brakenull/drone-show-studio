# Copy to .env (git-ignored) and fill in. A variable already set in the environment wins.

# Open-Meteo customer API key for the forecast stress test. Empty = the free API (non-commercial use only).
OPEN_METEO_API_KEY=

# Ensemble model for the forecast stress test (default ecmwf_ifs025). Others: gfs_seamless, gem_global.
OPEN_METEO_MODEL=
